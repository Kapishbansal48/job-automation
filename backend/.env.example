# Server
PORT=4000
NODE_ENV=development

# Database (Prisma). Default uses local SQLite so the project runs with zero setup.
# To use PostgreSQL instead, install the pg-compatible Prisma provider and set:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/job_automation?schema=public"
DATABASE_URL="file:./dev.db"

# Greenhouse board to scrape. Any public Greenhouse company works, e.g. "gitlab", "stripe", "airbnb".
GREENHOUSE_BOARD_TOKEN=gitlab

# Max number of jobs to pull from the board on each scrape
MAX_JOBS=15

# Candidate data
CANDIDATE_PROFILE_PATH=../data/candidate.json
RESUME_PATH=../data/resume.pdf

# Automation
SCREENSHOTS_DIR=../screenshots
HEADLESS=true
AUTOMATION_TIMEOUT_MS=45000
MAX_RETRIES=2
